# Optional template only: the app does not automatically load .env files.
PARALLAX_MODE=fixture
PARALLAX_DATA_DIR=.data
PORT=3000
# Live mode requires explicit operator configuration; do not enable for tests.
PARALLAX_LIVE_APPROVED=false
# Enable only the bounded anonymous session workflow.
PARALLAX_PUBLIC_DEMO=false
PARALLAX_CREDIT_BUDGET=0
PARALLAX_MAX_REQUEST_CREDITS=11
# NANSEN_API_KEY=YOUR_SERVER_SIDE_NANSEN_API_KEY
# PARALLAX_ADMIN_TOKEN=YOUR_PRIVATE_OPERATOR_TOKEN_AT_LEAST_24_CHARACTERS
# PARALLAX_PUBLIC_ORIGIN=https://YOUR_DEPLOYMENT_HOST
